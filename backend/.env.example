# Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=healthforge
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production_minimum_32_characters_long
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Alert Thresholds
ALERT_LOW_STOCK_PERCENTAGE=20
ALERT_NEAR_EXPIRY_DAYS=90
ALERT_CONSUMPTION_SPIKE_MULTIPLIER=2.5
